        "description": "API Key"
      }
    },
    "schemas": {
      "TagDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "PackageDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "packageId": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "docs": {
            "type": "string",
            "nullable": true
          },
          "icon": {
            "type": "string",
            "nullable": true
          },
          "author": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "packageTags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PackageTagDto"
            }
          }
        },
        "required": [
          "id",
          "packageId",
          "version",
          "name",
          "createdAt",
          "updatedAt",
          "packageTags"
        ]
      },
      "PackageTagDto": {
        "type": "object",
        "properties": {
          "packageId": {
            "type": "string",
            "description": "The ID of the package"
          },
          "tagId": {
            "type": "string",
            "description": "The ID of the tag"
          },
          "tag": {
            "description": "Tag metadata",
            "allOf": [
              {
                "$ref": "#/components/schemas/TagDto"
              }
            ]
          },
          "package": {
            "description": "Package metadata",
            "allOf": [
              {
                "$ref": "#/components/schemas/PackageDto"
              }
            ]
          }
        },
        "required": [
          "packageId",
          "tagId",
          "tag",
          "package"
        ]
      }
    }
