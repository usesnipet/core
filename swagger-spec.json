          },
          {
            "name": "skip",
            "required": false,
            "in": "query",
            "description": "Alias for `offset`.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Packages found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PackageDto"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Package"
        ]
